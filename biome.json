{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"files": {
		"includes": ["src/**/*.ts", "scripts/**/*.ts"]
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"formatter": {
		"indentStyle": "tab",
		"indentWidth": 2
	},
	"javascript": {
		"formatter": {
			"arrowParentheses": "always",
			"bracketSpacing": false,
			"quoteStyle": "single",
			"trailingCommas": "es5"
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"rules": {
			"preset": "recommended"
		}
	}
}
